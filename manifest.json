{
  "manifest_version": 3,
  "name": "nKemono",
  "description": "Inspired by nCage.  It replaces all of your images by Kemono Friends",
  "version": "4.3",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "kemono.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_icon": "icon.png"
  },
  "content_security_policy": {}
}
